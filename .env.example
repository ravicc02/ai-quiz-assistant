# OpenAI-compatible chat completions endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_FALLBACK_MODEL=
AI_REASONING_EFFORT=high

# Desktop backend.
MUMU_DATA=
ANSWER_STUDIO_HOST=127.0.0.1
ANSWER_STUDIO_PORT=8877
ANSWER_STUDIO_DATA=
ANSWER_STUDIO_CHROME_PATH=

# Required for long-lived QR group links.
MUMU_ATTENDANCE_SHARE_URL=
MUMU_ATTENDANCE_SHARE_SECRET=
MUMU_ATTENDANCE_RELAY_CNAME_TARGET=
MUMU_ATTENDANCE_DOMAIN_TOKEN=
# Optional attendance pressure controls.
MUMU_ATTENDANCE_SIGN_CONCURRENCY=8
MUMU_ATTENDANCE_AUTO_GROUP_BURST_CONCURRENCY=6
MUMU_ATTENDANCE_SCAN_QPS=12
MUMU_ATTENDANCE_SIGN_QPS=10

# Optional WeChat iLink Bot binding. The desktop UI can also bind by QR code.
WEIXIN_BOT_TOKEN=
WEIXIN_USER_ID=
WEIXIN_CONTEXT_TOKEN=
WEIXIN_BASE_URL=https://ilinkai.weixin.qq.com
