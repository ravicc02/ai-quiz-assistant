{
  "name": "mumu-desktop",
  "version": "0.7.0",
  "description": "Mumu local Windows learning task workspace",
  "author": "Mumu Contributors",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5174 && electron .\"",
    "web": "vite",
    "test": "node --test test/*.test.mjs",
    "prebuild:web": "node ../scripts/version.mjs check",
    "build:web": "vite build",
    "build:backend": "powershell -ExecutionPolicy Bypass -File ../scripts/build-backend.ps1",
    "prebuild:win": "node ../scripts/release.mjs check",
    "build:win": "vite build && npm run build:backend && electron-builder --win nsis --x64 --publish never",
    "preview": "vite preview"
  },
  "dependencies": {
    "@lucide/vue": "^1.72.0",
    "cannon-es": "^0.20.0",
    "qrcode": "^1.5.4",
    "three": "^0.187.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^10.0.7",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "rcedit": "^5.0.2",
    "vite": "^8.3.7",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "io.github.ravicc02.mumu",
    "productName": "Mumu",
    "directories": {
      "output": "release"
    },
    "afterPack": "scripts/after-pack.cjs",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "product.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/mumu-backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "artifactName": "Mumu-${version}-windows-${arch}-setup.${ext}",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "guid": "eb16fffb-9f96-5004-94a4-fb5b2f48fec9"
    }
  }
}
